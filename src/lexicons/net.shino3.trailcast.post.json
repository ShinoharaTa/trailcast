{
  "lexicon": 1,
  "id": "net.shino3.trailcast.post",
  "defs": {
    "main": {
      "type": "record",
      "description": "A checkpoint (post) within a thread",
      "key": "tid",
      "record": {
        "type": "object",
        "required": ["thread", "checkpointAt", "createdAt"],
        "properties": {
          "thread": {
            "type": "string",
            "format": "at-uri",
            "description": "AT URI of the parent thread"
          },
          "text": {
            "type": "string",
            "maxLength": 200,
            "description": "Checkpoint text"
          },
          "images": {
            "type": "array",
            "maxLength": 4,
            "items": {
              "type": "blob",
              "accept": ["image/jpeg", "image/png", "image/webp"],
              "maxSize": 1000000
            },
            "description": "Up to 4 images"
          },
          "location": {
            "type": "object",
            "properties": {
              "latitude": { "type": "number" },
              "longitude": { "type": "number" },
              "altitude": { "type": "number" }
            },
            "required": ["latitude", "longitude"],
            "description": "Device GPS location"
          },
          "tags": {
            "type": "array",
            "maxLength": 50,
            "items": {
              "type": "string",
              "maxLength": 64
            },
            "description": "Tags for filtering and aggregation within a thread. Stored without the leading '#'; compared case-insensitively."
          },
          "fields": {
            "type": "array",
            "maxLength": 30,
            "description": "Values for the thread's custom fields. Each item references a thread.fields[].id. Posts without this property fall back to tags matching option labels (legacy).",
            "items": {
              "type": "union",
              "refs": ["#selectValue", "#numberValue", "#durationValue", "#textValue"]
            }
          },
          "checkpointAt": {
            "type": "string",
            "format": "datetime",
            "description": "Checkpoint timestamp (editable)"
          },
          "exif": {
            "type": "object",
            "description": "EXIF metadata from photos (opt-in)"
          },
          "sourceRef": {
            "type": "string",
            "format": "at-uri",
            "description": "AT URI of the original Bluesky post (if imported)"
          },
          "imageUrls": {
            "type": "array",
            "maxLength": 4,
            "items": { "type": "string", "format": "uri" },
            "description": "External image URLs (for imported posts whose blobs cannot be copied)"
          },
          "createdAt": {
            "type": "string",
            "format": "datetime",
            "description": "Record creation timestamp"
          }
        }
      }
    },
    "selectValue": {
      "type": "object",
      "required": ["field", "options"],
      "properties": {
        "field": { "type": "string", "maxLength": 16 },
        "options": {
          "type": "array",
          "maxLength": 50,
          "items": { "type": "string", "maxLength": 16 }
        }
      }
    },
    "numberValue": {
      "type": "object",
      "required": ["field", "value"],
      "properties": {
        "field": { "type": "string", "maxLength": 16 },
        "value": {
          "type": "string",
          "maxLength": 32,
          "description": "Decimal string, e.g. \"12.5\". Lexicon has no float type; string keeps it lossless and readable by clients that do not have the thread definition"
        }
      }
    },
    "durationValue": {
      "type": "object",
      "required": ["field", "seconds"],
      "properties": {
        "field": { "type": "string", "maxLength": 16 },
        "seconds": { "type": "integer", "minimum": 0 }
      }
    },
    "textValue": {
      "type": "object",
      "required": ["field", "text"],
      "properties": {
        "field": { "type": "string", "maxLength": 16 },
        "text": { "type": "string", "maxLength": 200 }
      }
    }
  }
}
